@page "/blacklist"
@rendermode InteractiveServer
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Data
@using Zilean.ApiService.Features.Dashboard.Components.Pages.Dashboard

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3>Blacklisted Items</h3>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <SfGrid TValue="BlacklistItemDetails" AllowSorting="true" AllowFiltering="true" AllowResizing="true" AllowPaging="true" Toolbar="@_toolbarOptions" EnableHover="true" EnableStickyHeader="true" GridLines="GridLine.Both" EnableAltRow="true">
                <SfDataManager AdaptorInstance="typeof(DashboardBlacklistDataAdapter)" Adaptor="Adaptors.CustomAdaptor"></SfDataManager>
                <GridPageSettings PageSizes="@_pageSizes" PageSize="@_initialPageSize"></GridPageSettings>
                <GridColumns>
                    <GridColumn Field=@nameof(BlacklistItemDetails.InfoHash) HeaderText="Info Hash" TextAlign="TextAlign.Left" Width="320" IsPrimaryKey="true" ClipMode="ClipMode.EllipsisWithTooltip" AllowResizing="true"></GridColumn>
                    <GridColumn Field=@nameof(BlacklistItemDetails.Reason) HeaderText="Reason" TextAlign="TextAlign.Left" Width="300" ClipMode="ClipMode.EllipsisWithTooltip" AllowResizing="true"></GridColumn>
                    <GridColumn Field=@nameof(BlacklistItemDetails.BlacklistedAt) HeaderText="Blacklisted At" TextAlign="TextAlign.Left" Width="200" Format="yyyy-MM-dd HH:mm:ss" AllowResizing="true"></GridColumn>
                </GridColumns>
            </SfGrid>
        </div>
    </div>
</div>

@code {
    private readonly Array _pageSizes = new[] { 100, 50, 25, 10 };
    private readonly int _initialPageSize = 25;
    private readonly List<string> _toolbarOptions = ["Delete", "Search"];
}